<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>TuS Meinerzhagen Ticker Filter</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #121212; color: #e0e0e0; padding: 20px; }
        h2 { color: #ff690a; }
        button { background-color: #ff690a; color: white; border: none; padding: 10px 20px; font-size: 16px; cursor: pointer; border-radius: 5px; }
        button:hover { background-color: #e05b00; }
        .match-box { background-color: #1e1e1e; border: 1px solid #333; padding: 15px; margin-bottom: 10px; border-radius: 5px; }
        .match-teams { font-weight: bold; font-size: 18px; color: #fff; }
        .match-date { color: #bbb; margin: 5px 0; }
        .match-id { font-family: monospace; color: #888; font-size: 14px; }
    </style>
</head>
<body>

    <h2>TuS Meinerzhagen Match-Finder</h2>
    <p>Klicke auf den Button, um die aktuellen Spiele aus dem WVV-Ticker zu laden und nach Meinerzhagen zu filtern:</p>
    <button onclick="fuelleSpiele()">Spiele abrufen</button>
    
    <div id="ergebnis" style="margin-top: 20px;"></div>

    <script>
        async function fuelleSpiele() {
            const container = document.getElementById('ergebnis');
            container.innerHTML = "Lade Daten...";

            try {
                const response = await fetch('https://backend.sams-ticker.de/live/indoor/tickers/wvv');
                const data = await response.json();
                
                const matches = Array.isArray(data) ? data : (data.matches || data.content || data.elements || []);
                
                const meinerzhagenSpiele = matches.filter(m => 
                    m.teamDescription1?.toLowerCase().includes('meinerzhagen') || 
                    m.teamDescription2?.toLowerCase().includes('meinerzhagen')
                );

                if (meinerzhagenSpiele.length === 0) {
                    container.innerHTML = "<p>Keine Spiele für Meinerzhagen gefunden.</p>";
                    return;
                }

                container.innerHTML = "";
                meinerzhagenSpiele.forEach(m => {
                    const datumFormatiert = new Date(m.date).toLocaleString('de-DE', {
                        dateStyle: 'full',
                        timeStyle: 'short'
                    });

                    const div = document.createElement('div');
                    div.className = 'match-box';
                    div.innerHTML = `
                        <div class="match-teams">${m.teamDescription1} vs ${m.teamDescription2}</div>
                        <div class="match-date">📅 ${datumFormatiert}</div>
                        <div class="match-id">ID: ${m.id}</div>
                    `;
                    container.appendChild(div);
                });

            } catch (error) {
                container.innerHTML = "<p style='color: red;'>Fehler beim Laden der Daten (CORS-Blockade?). Tipp: Nutze zur Not die Browser-Konsole oder einen lokalen Live-Server.</p>";
                console.error(error);
            }
        }
    </script>

</body>
</html>
